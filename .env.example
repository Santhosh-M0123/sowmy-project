# --- LiveKit Cloud (required for the agent worker) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Name registered with LiveKit for this agent worker / used for dispatch.
# This is also what you'll attach to the telephony line in the LiveKit
# Cloud dashboard.
AGENT_NAME=college-voice-agent

# --- LiveKit Inference model choices (STT/LLM/TTS), optional overrides ---
# STT_MODEL=cartesia/ink-whisper
# LLM_MODEL=openai/gpt-4.1-mini
# TTS_MODEL=cartesia/sonic-2
# TTS_VOICE=

# --- Call recording to S3 (optional — leave S3_BUCKET blank to disable) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# --- Local dashboard API ---
PORT=8000
